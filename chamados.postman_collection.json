              ]
            },
            "description": "**RF-16** — Técnico asignado resuelve el ticket con solución, pasando a `RESOLVIDO` con `dataFechamento`. Si no es el asignado o estado es inválido, responde **409 Conflict**."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var tecnicoId = Number(pm.variables.get('tecnicoId'));",
                  "pm.sendRequest({",
                  "  url: pm.variables.replaceIn('{{baseUrl}}/chamados'),",
                  "  method: 'POST',",
                  "  header: { 'Content-Type': 'application/json' },",
                  "  body: JSON.stringify({",
                  "    titulo: 'Chamado para resolver ' + Date.now(),",
                  "    descricao: 'Chamado criado automaticamente pela colecao de Postman.',",
                  "    local: 'Laboratorio de Redes',",
                  "    prioridade: 'MEDIA',",
                  "    categoriaId: Number(pm.variables.get('categoriaId')),",
                  "    solicitanteId: Number(pm.variables.get('solicitanteId'))",
                  "  })",
                  "}, function (err, res) {",
                  "  if (err || res.code !== 201) { console.error('Falha ao criar chamado para resolver', err); return; }",
                  "  var novoId = res.json().id;",
                  "  pm.sendRequest({",
                  "    url: pm.variables.replaceIn('{{baseUrl}}/chamados/' + novoId + '/assumir'),",
                  "    method: 'PATCH',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: JSON.stringify({ tecnicoId: tecnicoId })",
                  "  }, function (err2, res2) {",
                  "    if (err2 || res2.code !== 200) { console.error('Falha ao assumir chamado para resolver', err2); return; }",
                  "    pm.collectionVariables.set('chamadoResolverId', novoId);",
                  "  });",
                  "});"
                ]
              }
            },
