              ]
            },
            "description": "**RF-26** — Devuelve los detalles de un sector por ID con **200 OK**, o **404 Not Found** si no existe."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Setor devuelto', function () {",
                  "  var b = pm.response.json();",
