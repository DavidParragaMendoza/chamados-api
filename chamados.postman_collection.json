          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Respuesta paginada', function () { var b = pm.response.json(); pm.expect(b.content).to.be.an('array'); pm.expect(b.totalElements).to.be.a('number'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar setor por id",
          "request": {
