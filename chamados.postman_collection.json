  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "var stamp = Date.now().toString().slice(-9);",
          "pm.collectionVariables.set('siglaTemp', 'T' + stamp);",
          "pm.collectionVariables.set('emailTemp', 'postman' + stamp + '@ifrn.edu.br');",
          "pm.collectionVariables.set('matriculaTemp', 'P' + stamp);",
          "pm.collectionVariables.set('tituloTemp', 'Chamado de teste ' + stamp);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Setores",
      "description": "Gestión de sectores (CRUD completo). RF-1 a RF-5, RF-26, RF-27.",
      "item": [
        {
          "name": "Criar setor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Setor de Teste {{siglaTemp}}\",\n  \"sigla\": \"{{siglaTemp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/setores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "setores"
              ]
            },
            "description": "**RF-1** — Registra un sector con `ativo = true` y responde **201 Created** con la cabecera `Location`.\n\n**RF-2** — Si la `sigla` ya existe responde **409 Conflict**."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Cabecera Location presente', function () { pm.expect(pm.response.headers.get('Location')).to.be.a('string'); });",
                  "pm.test('Sector activo', function () { pm.expect(pm.response.json().ativo).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar setores",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/setores?page=0&size=10&sort=nome",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "setores"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0",
                  "description": "Página (base 0)"
                },
                {
                  "key": "size",
                  "value": "10",
                  "description": "Tamaño de página"
                },
                {
                  "key": "sort",
                  "value": "nome",
