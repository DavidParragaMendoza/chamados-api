    {
      "name": "Chamados",
      "description": "Ciclo de vida y consultas de tickets. RF-13 a RF-18, RF-21, RF-22, RF-32 a RF-34.",
      "item": [
        {
          "name": "Abrir chamado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"{{tituloTemp}}\",\n  \"descricao\": \"Chamado de teste aberto pela coleção de Postman.\",\n  \"local\": \"Laboratório de Redes\",\n  \"prioridade\": \"ALTA\",\n  \"categoriaId\": {{categoriaId}},\n  \"solicitanteId\": {{solicitanteId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chamados",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chamados"
              ]
            },
            "description": "**RF-13** — Abre un ticket en estado `ABERTO` con prioridad informada (o `MEDIA` por defecto). Guarda `chamadoId` para las pruebas."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Chamado ABERTO', function () { pm.expect(pm.response.json().status).to.eql('ABERTO'); });",
                  "var body = pm.response.json();",
                  "if (body && body.id) { pm.collectionVariables.set('chamadoId', body.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar chamado por id com interações",
