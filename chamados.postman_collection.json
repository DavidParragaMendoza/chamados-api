      "type": "string"
    },
    {
      "key": "usuarioId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "chamadoId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "siglaTemp",
      "value": "TEMP",
      "type": "string"
    },
    {
      "key": "emailTemp",
      "value": "temp@ifrn.edu.br",
      "type": "string"
    },
    {
      "key": "matriculaTemp",
      "value": "0000000",
      "type": "string"
    },
    {
      "key": "tituloTemp",
      "value": "Chamado de teste",
