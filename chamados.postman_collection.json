              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"solucao\": \"Foi realizada a sincronização do cadastro do usuário com o sistema de ponto eletrônico.\",\n  \"tecnicoId\": {{tecnicoId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chamados/{{chamadoResolverId}}/resolver",
              "host": [
