              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Chamado RESOLVIDO', function () { pm.expect(pm.response.json().status).to.eql('RESOLVIDO'); });"
                ]
              }
            }
          ]
